generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  REFERRER
}

enum JobStatus {
  UNASSIGNED
  ASSIGNED
  SUBMITTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  jobs         Job[]
  earnings     Earning[]
  payouts      Payout[]

  // Who brought this transcriber in. The referrer earns a one-off bonus for them.
  referredById     String?
  referredBy       User?           @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]          @relation("Referrals")
  bonusesEarned    ReferralBonus[] @relation("BonusReferrer")
  bonusTriggeredBy ReferralBonus?  @relation("BonusTranscriber")
}

model Job {
  id                 String    @id @default(cuid())
  title              String
  mediaPath          String
  mediaType          String
  durationSeconds    Int
  originalTranscript String
  editedTranscript   String
  status             JobStatus @default(UNASSIGNED)
  assigneeId         String?
  assignee           User?     @relation(fields: [assigneeId], references: [id])
  assignedAt         DateTime?
  submittedAt        DateTime?
  earnings           Earning[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Payout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  note      String?
  createdAt DateTime @default(now())
}

// Credited to a user when they submit a job. One per job and user, so resubmitting never pays twice.
model Earning {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  // Media length credited. Totals are paid on cumulative time, not the sum of rounded per-job amounts.
  seconds   Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([jobId, userId])
}

// One-off bonus a referrer earns when a transcriber they referred submits their first transcript.
model ReferralBonus {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation("BonusReferrer", fields: [referrerId], references: [id])
  transcriberId String   @unique
  transcriber   User     @relation("BonusTranscriber", fields: [transcriberId], references: [id])
  amount        Int
  createdAt     DateTime @default(now())
}

// Simple key/value settings, e.g. the next pay date admins announce to everyone.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
