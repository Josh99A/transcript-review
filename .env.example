# Postgres connection string, e.g. from a local Postgres or Render Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transcript_review"
# Long random string used to sign login cookies (at least 32 characters).
SESSION_SECRET="replace-with-a-long-random-string"
# Cloudinary credentials for media storage (Cloudinary dashboard > API Keys > API environment variable).
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Optional: copy approved jobs to Google Drive. OAuth client (Web application) from Google Cloud > APIs & Services > Credentials,
# with https://<your app>/api/drive-export/callback as an authorised redirect URI. Then connect Drive from the admin dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: email notifications through Resend (resend.com > API Keys). Without a key, notices stay in the app only.
# EMAIL_FROM must use a domain verified in Resend; until then Resend only delivers to your own Resend account's email.
RESEND_API_KEY=
EMAIL_FROM="Transcript Review <notifications@your-domain.com>"
# Optional: public address of the app, used for links in emails. On Render the service's own URL is used when empty.
APP_URL=
