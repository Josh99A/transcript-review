generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  REFERRER
}

enum JobStatus {
  UNASSIGNED
  ASSIGNED
  SUBMITTED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  jobs          Job[]
  earnings      Earning[]      @relation("Earnings")
  payouts       Payout[]
  jobRequests   JobRequest[]
  notifications Notification[]
  issues        Issue[]
  issueMessages IssueMessage[]

  // Where payments go, entered by the person themselves (or an admin).
  payNetwork String?
  payPhone   String?
  payName    String?
  // Languages a transcriber says they can work in, so admins can match them to jobs.
  languages  String[] @default([])

  // Who brought this transcriber in. The referrer earns per hour of transcript this person submits.
  referredById     String?
  referredBy       User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]    @relation("Referrals")
  referralEarnings Earning[] @relation("ReferralEarnings")
}

model Job {
  id                    String         @id @default(cuid())
  title                 String
  // Details shown on the job board and to the transcriber.
  description           String         @default("")
  // When an admin last changed the description, so the transcriber can see it was updated.
  instructionsUpdatedAt DateTime?
  // Tells jobs apart, e.g. the client or study a recording belongs to.
  project               String?
  language              String?
  deadline              DateTime?
  // Unassigned jobs on the board can be requested by transcribers.
  posted                Boolean        @default(false)
  requests              JobRequest[]
  // Cloudinary asset as "<public id>.<format>", and its size in bytes.
  mediaPath             String
  mediaBytes            Int            @default(0)
  mediaType             String
  durationSeconds       Int
  // Special jobs paid at their own hourly rate (UGX per hour) instead of the usual one.
  ratePerHour           Int?
  // Paid this amount as is, whatever the length or the usual rate. Never set together with ratePerHour.
  fixedPay              Int?
  // "html" for transcripts that came from Word with their formatting; "text" for plain ones.
  transcriptFormat      String         @default("text")
  originalTranscript    String
  editedTranscript      String
  status                JobStatus      @default(UNASSIGNED)
  assigneeId            String?
  assignee              User?          @relation(fields: [assigneeId], references: [id])
  assignedAt            DateTime?
  submittedAt           DateTime?
  // Set when an admin deletes the media file to save space; the job and its records stay.
  mediaRemovedAt        DateTime?
  // Admin review of a submission. A send-back stores the instructions; approval marks it done.
  reviewNote            String?
  // When an admin last added to the send-back notes after sending the job back.
  reviewNoteEditedAt    DateTime?
  reviewedAt            DateTime?
  approvedAt            DateTime?
  revisions             Int            @default(0)
  earnings              Earning[]
  issues                Issue[]
  notifications         Notification[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Payout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  note      String?
  createdAt DateTime @default(now())
}

// Credited to a user when they submit a job. One per job and user, so resubmitting never pays twice.
model Earning {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("Earnings", fields: [userId], references: [id])
  amount     Int
  // Referrer at the time of submission; they earn the referral rate on these seconds.
  referrerId String?
  referrer   User?    @relation("ReferralEarnings", fields: [referrerId], references: [id])
  // Media length credited. Totals are paid on cumulative time, not the sum of rounded per-job amounts.
  seconds    Int      @default(0)
  // Paid at the job's own hourly rate: amount is paid as is, and these seconds don't count toward hourly pay.
  customRate Boolean  @default(false)
  // Usual hourly rate fixed when the job was approved, so a later rate change doesn't alter approved pay. Null: today's rate.
  lockedRate Int?
  createdAt  DateTime @default(now())

  @@unique([jobId, userId])
}

// Simple key/value settings, e.g. the next pay date admins announce to everyone.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// A transcriber asking to take a job from the board. The admin approves one, which assigns the job.
model JobRequest {
  id        String        @id @default(cuid())
  jobId     String
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@unique([jobId, userId])
}

/// An in-app notice for one person, shown under the bell until they read it.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String
  // The job it's about and what happened, so the list can tell when it's been overtaken by events.
  jobId     String?
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([jobId])
  @@index([userId, createdAt])
}

enum IssueStatus {
  OPEN
  RESOLVED
}

/// A problem a transcriber raised about a job, and the conversation with admins about it.
model Issue {
  id         String         @id @default(cuid())
  jobId      String
  job        Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  status     IssueStatus    @default(OPEN)
  messages   IssueMessage[]
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status, updatedAt])
  @@index([jobId])
}

model IssueMessage {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}
